{
  "name": "pantalla-local",
  "version": "1.0.0",
  "private": true,
  "description": "Señalización digital 24/7 para pantalla LG webOS en escaparate: reproductor /tv, panel /admin y API para Make.com con motor de respaldo sin IA.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:templates": "node scripts/check-templates.mjs",
    "check:tv": "node scripts/check-tv-bundle.mjs"
  },
  "browserslist": [
    "chrome >= 79",
    "safari >= 14",
    "firefox >= 78"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/redis": "1.41.0",
    "@vercel/blob": "2.9.0",
    "cheerio": "1.2.0",
    "next": "15.5.29",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "es-check": "9.9.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
