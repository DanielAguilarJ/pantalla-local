# Copia este archivo a .env.local (desarrollo) y carga las mismas variables en Vercel.

# Token que Make.com envía en "Authorization: Bearer <SYNC_SECRET>" a /api/webhook/make.
SYNC_SECRET=cambia_esto_por_una_clave_larga

# Contraseña del panel /admin.
ADMIN_PASSWORD=cambia_esta_contrasena

# Opcional: secreto para firmar la cookie de sesión de /admin.
# Si no se define, se deriva de ADMIN_PASSWORD + SYNC_SECRET (cambiar la contraseña cierra todas las sesiones).
# ADMIN_SESSION_SECRET=

# Opcional: Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" al ejecutar el cron.
# Si no se define, el cron acepta SYNC_SECRET.
# CRON_SECRET=

# Almacenamiento persistente (Upstash Redis / Vercel KV). Basta con UNA de las dos parejas.
# Sin estas variables se usa el archivo /tmp/signage-state.json (solo para desarrollo local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Vercel Blob para subir imágenes/videos desde /admin (Vercel lo crea al conectar un Blob Store público).
# Sin esta variable, en local los archivos se guardan en /tmp/signage-uploads.
BLOB_READ_WRITE_TOKEN=

# Opcional: zona horaria con la que el motor de respaldo calcula la semilla diaria (YYYY-MM-DD).
# SIGNAGE_TZ=America/Mexico_City

# Opcional: ruta del archivo de estado local.
# SIGNAGE_STATE_FILE=/tmp/signage-state.json
